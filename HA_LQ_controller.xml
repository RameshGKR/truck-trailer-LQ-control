    <param name="clock" type="real" local="false" d1="1" d2="1" dynamics="any" controlled="true" />
    <bind component="D" as="D_1" x="858.0" y="151.0">
      <map key="y3">y3</map>
      <map key="theta3">theta3</map>
      <map key="beta2">beta2</map>
